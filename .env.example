# Linear credentials. Two modes — pick one.
#
# Mode A: OAuth agent (actor=app). Non-billable; appears as the Maestro app.
#   Create OAuth app at https://linear.app/settings/api/applications/new, then
#   complete the actor=app flow (see README for the full walkthrough).
#   Access tokens expire every 24h; the client refreshes via refresh_token.
LINEAR_API_KEY=lin_oauth_...
LINEAR_REFRESH_TOKEN=lin_refresh_...
LINEAR_CLIENT_ID=...
LINEAR_CLIENT_SECRET=...
#
# Mode B: Personal API key (billable seat). Generate from
# https://linear.app/settings/api — simpler, but uses a user seat.
#   LINEAR_API_KEY=lin_api_...
# (leave LINEAR_REFRESH_TOKEN / LINEAR_CLIENT_ID / LINEAR_CLIENT_SECRET unset.)

# GitHub Personal Access Token for the maestro bot user
# Used by spawned agents so PRs are authored by the bot, not you
GITHUB_TOKEN=github_pat_...

# concentrate.ai API key (OpenAI-compatible gateway).
# Used by the open-agent backend; not needed if you only use the `claude` backend.
CONCENTRATE_API_KEY=conc_...

# Where workspaces are created on disk. Workflow files reference this as
# ${MAESTRO_DATA_DIR}/<lane>. Set to /data/workspaces in production (matches
# the Fly volume mount). For local dev, anywhere your user can write is fine.
MAESTRO_DATA_DIR=/Users/your-name/maestro-workspaces

# Figma personal access token. Optional — when set, the agent gets three
# extra tools (figma_get_node, figma_render_node, figma_get_image_fills) for
# reading design files and exporting assets via the Figma REST API. Required
# for any workflow whose tickets reference figma.com URLs. Generate one at
# https://www.figma.com/developers/api#access-tokens with scopes
# `file_content:read` and `file_dev_resources:read`.
FIGMA_API_KEY=figd_...
